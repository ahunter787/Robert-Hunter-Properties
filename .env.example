# RHP environment configuration.
# Copy to .env (`make env` does this and generates a secret key) and edit.
# NEVER commit .env — it is gitignored and dockerignored.

# --- Django ---------------------------------------------------------------
# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
# development | production
DJANGO_SETTINGS_MODULE=config.settings.development
# Comma-separated. Required in production.
# Development answers on any host so a phone on the same network can reach it.
# To be explicit instead, list them: localhost,127.0.0.1,192.168.1.50
DJANGO_ALLOWED_HOSTS=*
# Comma-separated origins trusted for unsafe HTTPS requests (production).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC
# Production TLS topology. With Caddy in front, set both of these to 1.
# For an intentionally plain-HTTP LAN deployment, set DJANGO_SECURE_SSL_REDIRECT=0
# (cookies then stop being marked Secure, which is required to log in over HTTP).
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Database -------------------------------------------------------------
# POSTGRES_HOST stays localhost for host-side commands; Docker Compose
# overrides it to `db` for the web container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rhp
POSTGRES_USER=rhp
POSTGRES_PASSWORD=change-me
DB_CONN_MAX_AGE=60

# --- Server ---------------------------------------------------------------
# Hostname Caddy serves (production). Use the real public hostname.
RHP_HOSTNAME=localhost
# Address that receives TLS certificate notices (production with a real domain).
CADDY_EMAIL=admin@example.com
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# --- Authentication -------------------------------------------------------
# Invitation and password-reset links share this window (days).
RHP_LINK_TIMEOUT_DAYS=7
# Login throttling: this many failures inside the window locks the account or
# address for the lockout period. See docs/security.md.
RHP_LOGIN_MAX_ATTEMPTS=5
RHP_LOGIN_WINDOW_MINUTES=15
RHP_LOGIN_LOCKOUT_MINUTES=15
# Honour X-Forwarded-For for the throttled client address. Set to 1 only when a
# trusted proxy (Caddy in the production stack) sets the header.
RHP_TRUST_PROXY_HEADERS=0

# --- Portfolio media and maps ---------------------------------------------
# Property banner photos are uploaded to MEDIA_ROOT (the media_data volume).
# Maximum upload size in megabytes; larger files are refused before storage.
RHP_MAX_UPLOAD_MB=5
# Shortened Google Maps links (maps.app.goo.gl/...) carry no coordinates, so RHP
# expands them with one outbound request to Google. Set to 0 on a host with no
# outbound network; staff then paste the coordinates themselves.
RHP_RESOLVE_MAP_SHORT_LINKS=1
# Optional. Leave blank to use the keyless Google Maps embed on property pages.
# With a key, the official Embed API is used instead. RHP never calls Google
# from the server: the map is loaded by the browser.
GOOGLE_MAPS_EMBED_API_KEY=

# --- Email ----------------------------------------------------------------
# Console backend prints mail to the log; fine for development.
# Production must switch to SMTP (and fill in the host settings below) before
# Phase 1 sends tenant invitations or password resets.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=RHP <no-reply@localhost>
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=rhp@example.com
# DJANGO_EMAIL_HOST_PASSWORD=change-me
# DJANGO_EMAIL_USE_TLS=1
